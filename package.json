{
  "name": "blackwall-mcp",
  "version": "1.4.2",
  "repository": { "type": "git", "url": "git+https://github.com/bluetieroperations-create/blackwall-mcp.git" },
  "homepage": "https://blackwalltier.com",
  "mcpName": "com.blackwalltier/blackwall",
  "description": "API-key pre-action risk gate: any irreversible agent action (money, SQL, delete, email).",
  "type": "module",
  "bin": {
    "blackwall-mcp": "index.mjs",
    "blackwall-mcp-http": "http.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./lib/forecast": "./lib/forecast.mjs",
    "./lib/observe": "./lib/observe.mjs",
    "./lib/gate": "./lib/gate.mjs",
    "./lib": "./lib/index.mjs"
  },
  "files": [
    "index.mjs",
    "server.mjs",
    "http.mjs",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node index.mjs",
    "start:http": "node http.mjs",
    "test": "node --test",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\"",
    "secrets:scan": "gitleaks git --no-banner --config .gitleaks.toml"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "guardrails",
    "ai-safety",
    "blackwall"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
